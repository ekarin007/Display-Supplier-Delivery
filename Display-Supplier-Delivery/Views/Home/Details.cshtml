@model List<Display_Supplier_Delivery.Models.PartDetailViewModel>
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string supplierName = ViewBag.Supplier as string;
    string time = ViewBag.Time as string;
}

<div class="details-container">

    <!-- Top Navigation & Header Area -->
    <div style="display: flex; gap: 5px; margin-bottom: 5px;">
        <a href="@Url.Action("Index", "Home")" class="back-btn">Back</a>

        <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 5px;">
            <div style="display: flex; gap: 5px;">
                <div class="blue-box">@DateTime.Now.ToString("d MMMM, yyyy")</div>
                <div class="title-box" style="background-color: #203354;">MATERIAL RECEIVING LIST</div>
                <div class="right-info-box">
                    <div class="right-cell">SUPPLIER</div>
                    <div class="right-cell">STATUS</div>
                </div>
            </div>
            <div style="display: flex; gap: 5px;">
                <div class="blue-box" id="clock" style="color: #00ff00;">@DateTime.Now.ToString("HH:mm:ss")</div>
                <div class="title-box">SHIPPING TIME CHART : @time</div>
                <div class="right-info-box">
                    <div class="right-cell">@supplierName</div>
                    <div class="right-cell" style="color: @(ViewBag.Status == "DELAY" ? "#ff0000" : "#00ff00");">
                        @ViewBag.Status</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table -->
    <table class="details-table">
        <thead>
            <tr>
                <th rowspan="2" style="width: 50px;">Items</th>
                <th rowspan="2">Parts no.</th>
                <th colspan="2">Plan Receive</th>
                <th colspan="2">Actual</th>
                <th colspan="2">Diff</th>
            </tr>
            <tr>
                <th>Q'ty(Pcs)</th>
                <th>Q'ty(Box)</th>
                <th>Q'ty(Pcs)</th>
                <th>Q'ty(Box)</th>
                <th>Q'ty(Pcs)</th>
                <th>Q'ty(Box)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int i = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.PartNo</td>
                        <td>@item.PlanPcs.ToString("#,##0")</td>
                        <td>@item.PlanBox.ToString("#,##0")</td>
                        <td>@item.ActualPcs.ToString("#,##0")</td>
                        <td>@item.ActualBox.ToString("#,##0")</td>
                        <td>@item.DiffPcs.ToString("#,##0")</td>
                        <td>@item.DiffBox.ToString("#,##0")</td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="8" style="text-align:center;">No Data Found</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="footer-row">
                <td colspan="2">Total @Model.Count() Items</td>
                <td>@Model.Sum(x=>x.PlanPcs).ToString("#,##0")</td>
                <td>@Model.Sum(x => x.PlanBox).ToString("#,##0")</td>
                <td>@Model.Sum(x => x.ActualPcs).ToString("#,##0")</td>
                <td>@Model.Sum(x => x.ActualBox).ToString("#,##0")</td>
                <td>@Model.Sum(x => x.DiffPcs).ToString("#,##0")</td>
                <td>@Model.Sum(x => x.DiffBox).ToString("#,##0")</td>
            </tr>
        </tfoot>
    </table>
</div>

@section scripts {
    <script>
        // Digital clock
        setInterval(() => {
            const now = new Date();
            document.getElementById("clock").innerText = now.toLocaleTimeString('en-GB', { hour12: false });
        }, 1000);
    </script>
}
